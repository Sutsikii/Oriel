<Project>
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)../src/Oriel/Oriel.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../src/Oriel.Generators/Oriel.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)../src/Oriel.Build/Oriel.Build.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <PropertyGroup>
    <OrielBuildTasksAssembly>$(MSBuildThisFileDirectory)../src/Oriel.Build/bin/$(Configuration)/netstandard2.0/Oriel.Build.dll</OrielBuildTasksAssembly>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)../src/Oriel/build/Oriel.targets" />
</Project>
