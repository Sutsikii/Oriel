    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "jsdom": "~30.1.3",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "typescript": "~5.9.3",
    "vue": "~3.5.44"
  }
}
