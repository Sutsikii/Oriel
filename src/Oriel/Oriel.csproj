<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Oriel</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Desktop apps in C#, with a web frontend calling C# through a generated TypeScript client.</Description>
    <PackageTags>desktop;webview;webview2;typescript;source-generator;nativeaot</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- The build tasks are loaded by MSBuild from tasks/, not referenced from lib/. -->
    <NoWarn>$(NoWarn);NU5100</NoWarn>
    <!-- Oriel's experimental APIs, which it changes with their uses. -->
    <NoWarn>$(NoWarn);ORIEL901;ORIEL902</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Oriel.Tests" />
    <InternalsVisibleTo Include="Oriel.Generators.Tests" />
    <InternalsVisibleTo Include="Oriel.Stress.Tests" />
    <InternalsVisibleTo Include="Oriel.EndToEnd.Tests" />
    <InternalsVisibleTo Include="Oriel.Benchmarks" />
    <InternalsVisibleTo Include="Oriel.Hosting" />
    <InternalsVisibleTo Include="Oriel.Cli" />
    <EmbeddedResource Include="Bridge/bridge.js" LogicalName="Oriel.Bridge.bridge.js" />
  </ItemGroup>

  <!--
    The public API is declared in PublicAPI.*.txt: a change to it fails the
    build until it is declared there, so it shows in review. See
    CONTRIBUTING.md, "Change the public API".
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt;PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <!--
    The package carries the source generator, the build steps and their tasks, so that an
    app needs one PackageReference. Apps in this repository import them
    themselves: see examples/Directory.Build.targets.
  -->
  <ItemGroup>
    <ProjectReference Include="../Oriel.Generators/Oriel.Generators.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="../Oriel.Generators/bin/$(Configuration)/netstandard2.0/Oriel.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <ProjectReference Include="../Oriel.Build/Oriel.Build.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="../Oriel.Build/bin/$(Configuration)/netstandard2.0/Oriel.Build.dll" Pack="true" PackagePath="tasks/netstandard2.0" Visible="false" />
    <None Include="build/Oriel.props;build/Oriel.targets" Pack="true" PackagePath="build;buildTransitive" />
    <None Include="../../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
