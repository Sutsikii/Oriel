<Project>
  <!--
    Build steps of apps using Oriel. docs/build.md describes them.
  -->

  <!--
    Writes the TypeScript client: runs the app with ORIEL_GENERATE, which
    makes OrielApp.Run write the client of the services and return at once.
    The file is only rewritten when it changed, so dev servers do not reload
    for nothing.
  -->
  <Target Name="OrielWriteTypeScript"
          AfterTargets="Build"
          Condition="'$(OrielTypeScriptOutput)' != '' and '$(DesignTimeBuild)' != 'true' and '$(BuildingProject)' != 'false'">
    <PropertyGroup>
      <_OrielTypeScriptPath>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(OrielTypeScriptOutput)'))</_OrielTypeScriptPath>
      <_OrielHost Condition="'$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</_OrielHost>
      <_OrielHost Condition="'$(_OrielHost)' == ''">dotnet</_OrielHost>
    </PropertyGroup>
    <Exec Command="&quot;$(_OrielHost)&quot; &quot;$(TargetPath)&quot;"
          EnvironmentVariables="ORIEL_GENERATE=$(_OrielTypeScriptPath);ORIEL_DEV_URL="
          StandardOutputImportance="low" />
    <Message Importance="normal" Text="Oriel: TypeScript client at $(_OrielTypeScriptPath)" />
  </Target>

  <!--
    Builds an installer of the published app with Inno Setup: a per-user
    install, shortcuts, an uninstaller and a check for WebView2. The task
    runs in a process of its own, so that rebuilding it is never blocked by
    a build that loaded it.
  -->
  <!--
    When the app is published. With NativeAOT, CopyNativeBinary copies the
    executable to the publish folder after Publish: signing it, or packing
    it into the installer, before that would take the file it replaces.
  -->
  <PropertyGroup>
    <_OrielPublished Condition="'$(PublishAot)' == 'true'">CopyNativeBinary</_OrielPublished>
    <_OrielPublished Condition="'$(_OrielPublished)' == ''">Publish</_OrielPublished>
  </PropertyGroup>

  <UsingTask TaskName="Oriel.Build.WriteInnoSetupScript" AssemblyFile="$(OrielBuildTasksAssembly)" TaskFactory="TaskHostFactory" />

  <Target Name="OrielBuildInstaller"
          AfterTargets="$(_OrielPublished)"
          Condition="'$(OrielInstaller)' == 'true'">
    <PropertyGroup>
      <_OrielAppName>$(OrielAppName)</_OrielAppName>
      <_OrielAppName Condition="'$(_OrielAppName)' == ''">$(Product)</_OrielAppName>
      <_OrielAppName Condition="'$(_OrielAppName)' == ''">$(AssemblyName)</_OrielAppName>
      <_OrielAppVersion>$(OrielAppVersion)</_OrielAppVersion>
      <_OrielAppVersion Condition="'$(_OrielAppVersion)' == ''">$(Version)</_OrielAppVersion>
      <_OrielPublisher>$(OrielPublisher)</_OrielPublisher>
      <_OrielPublisher Condition="'$(_OrielPublisher)' == ''">$(Company)</_OrielPublisher>
      <_OrielInstallerIcon>$(OrielInstallerIcon)</_OrielInstallerIcon>
      <_OrielInstallerIcon Condition="'$(_OrielInstallerIcon)' == '' and '$(ApplicationIcon)' != ''">$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(ApplicationIcon)'))</_OrielInstallerIcon>
      <_OrielInstallerOutput>$(OrielInstallerOutput)</_OrielInstallerOutput>
      <_OrielInstallerOutput Condition="'$(_OrielInstallerOutput)' == ''">$(BaseOutputPath)installer</_OrielInstallerOutput>
      <_OrielInstallerOutput>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(_OrielInstallerOutput)'))</_OrielInstallerOutput>
      <_OrielInstallerScript>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'oriel-installer.iss'))</_OrielInstallerScript>
      <_OrielIscc>$(OrielInnoSetupCompiler)</_OrielIscc>
      <_OrielIscc Condition="'$(_OrielIscc)' == '' and Exists('$(LOCALAPPDATA)\Programs\Inno Setup 6\ISCC.exe')">$(LOCALAPPDATA)\Programs\Inno Setup 6\ISCC.exe</_OrielIscc>
      <_OrielIscc Condition="'$(_OrielIscc)' == '' and Exists('$(MSBuildProgramFiles32)\Inno Setup 6\ISCC.exe')">$(MSBuildProgramFiles32)\Inno Setup 6\ISCC.exe</_OrielIscc>
      <_OrielIscc Condition="'$(_OrielIscc)' == '' and Exists('$(ProgramW6432)\Inno Setup 6\ISCC.exe')">$(ProgramW6432)\Inno Setup 6\ISCC.exe</_OrielIscc>
    </PropertyGroup>

    <Error Condition="'$(OS)' != 'Windows_NT'" Text="Oriel: installers are built on Windows." />
    <Error Condition="'$(_OrielIscc)' == ''"
           Text="Oriel: OrielInstaller needs Inno Setup 6, which was not found. Install it (winget install JRSoftware.InnoSetup), or set OrielInnoSetupCompiler to the path of ISCC.exe." />

    <WriteInnoSetupScript AppName="$(_OrielAppName)"
                          AppVersion="$(_OrielAppVersion)"
                          AppId="$(OrielAppId)"
                          Publisher="$(_OrielPublisher)"
                          Executable="$(AssemblyName).exe"
                          PublishDirectory="$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(PublishDir)'))"
                          OutputDirectory="$(_OrielInstallerOutput)"
                          Icon="$(_OrielInstallerIcon)"
                          Languages="$(OrielInstallerLanguages)"
                          UrlSchemes="$(OrielUrlSchemes)"
                          FileTypes="$(OrielFileTypes)"
                          SignCommand="$(OrielSignCommand)"
                          ScriptPath="$(_OrielInstallerScript)">
      <Output TaskParameter="SignToolArgument" PropertyName="_OrielSignTool" />
    </WriteInnoSetupScript>
    <Exec Command="&quot;$(_OrielIscc)&quot; /Q &quot;$(_OrielSignTool)&quot; &quot;$(_OrielInstallerScript)&quot;" Condition="'$(_OrielSignTool)' != ''" />
    <Exec Command="&quot;$(_OrielIscc)&quot; /Q &quot;$(_OrielInstallerScript)&quot;" Condition="'$(_OrielSignTool)' == ''" />
    <Message Importance="high" Text="Oriel: installer of $(_OrielAppName) $(_OrielAppVersion) in $(_OrielInstallerOutput)" />
  </Target>

  <!--
    Signs the published executable with OrielSignCommand, before the
    installer takes it: signtool, Azure Trusted Signing, or any command,
    its {file} replaced by the executable's quoted path.
  -->
  <Target Name="OrielSignExecutable"
          AfterTargets="$(_OrielPublished)"
          BeforeTargets="OrielBuildInstaller"
          Condition="'$(OrielSignCommand)' != ''">
    <PropertyGroup>
      <_OrielSignedFile>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(PublishDir)$(AssemblyName).exe'))</_OrielSignedFile>
      <_OrielSignedFile Condition="!Exists('$(_OrielSignedFile)')">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(PublishDir)$(AssemblyName)'))</_OrielSignedFile>
    </PropertyGroup>
    <Error Condition="!$(OrielSignCommand.Contains('{file}'))"
           Text="Oriel: OrielSignCommand has no {file}, where the file to sign goes, such as: signtool sign /fd SHA256 /f cert.pfx {file}." />
    <Exec Command="$(OrielSignCommand.Replace('{file}', '&quot;$(_OrielSignedFile)&quot;'))" />
    <Message Importance="high" Text="Oriel: signed $(_OrielSignedFile)" />
  </Target>

  <!-- Builds the frontend in Release builds, when a command is set. -->
  <Target Name="OrielBuildFrontend"
          BeforeTargets="OrielCollectFrontend"
          Condition="'$(OrielFrontendBuildCommand)' != '' and '$(Configuration)' == 'Release' and '$(DesignTimeBuild)' != 'true'">
    <Exec Command="$(OrielFrontendBuildCommand)" WorkingDirectory="$(MSBuildProjectDirectory)/$(OrielFrontendDirectory)" />
  </Target>

  <!--
    Copies the built frontend to wwwroot, which OrielApp serves pages from,
    or with OrielEmbedFrontend embeds it in the assembly, as resources named
    oriel-frontend/ and the file's path (see EmbeddedFrontend.cs). Collected
    when the target runs rather than when the project loads, so a frontend
    built during the build is included.
  -->
  <Target Name="OrielCollectFrontend"
          BeforeTargets="AssignTargetPaths"
          Condition="'$(OrielFrontendDist)' != ''">
    <ItemGroup>
      <_OrielFrontendFile Include="$(MSBuildProjectDirectory)/$(OrielFrontendDist)/**/*" />
      <Content Include="@(_OrielFrontendFile)"
               Condition="'$(OrielEmbedFrontend)' != 'true'"
               Link="wwwroot/%(RecursiveDir)%(Filename)%(Extension)"
               CopyToOutputDirectory="PreserveNewest"
               CopyToPublishDirectory="PreserveNewest" />
      <EmbeddedResource Include="@(_OrielFrontendFile)"
                        Condition="'$(OrielEmbedFrontend)' == 'true'"
                        LogicalName="oriel-frontend/%(RecursiveDir)%(Filename)%(Extension)"
                        WithCulture="false"
                        Type="Non-Resx" />
    </ItemGroup>
  </Target>

  <!--
    Deletes the files of the published wwwroot this publish did not copy
    there. The SDK cleans up after a publish with the same options only:
    publishing with -r win-x64, then without, or after another publish to
    the same folder, leaves the frontend's earlier files, which bundlers name
    after their content. The installer takes the whole publish folder, so
    they would be installed.
  -->
  <Target Name="OrielDeleteStaleFrontendFiles"
          AfterTargets="CopyFilesToPublishDirectory"
          Condition="'$(OrielFrontendDist)' != ''">
    <ItemGroup>
      <_OrielPublishedFile Include="@(ResolvedFileToPublish->'$(PublishDir)%(RelativePath)')" />
      <_OrielFoundFile Include="$(PublishDir)wwwroot\**\*" />
      <!-- Full paths on both sides: Exclude compares paths as they are written. -->
      <_OrielStaleFile Include="@(_OrielFoundFile->'%(FullPath)')" Exclude="@(_OrielPublishedFile->'%(FullPath)')" />
    </ItemGroup>
    <Delete Files="@(_OrielStaleFile)" />
    <Message Condition="'@(_OrielStaleFile)' != ''" Importance="normal" Text="Oriel: deleted files of an earlier publish from wwwroot: @(_OrielStaleFile, ', ')" />
  </Target>
</Project>
