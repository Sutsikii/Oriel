<Project>
  <!--
    Settings of apps using Oriel, imported before the project's own. Every
    property can be set in the app's project; docs/build.md describes them.
  -->
  <PropertyGroup>
    <!-- Where the TypeScript client is written after each build, relative to the project. Empty: nowhere. -->
    <OrielTypeScriptOutput Condition="'$(OrielTypeScriptOutput)' == ''"></OrielTypeScriptOutput>
    <!-- The folder of the built frontend, copied to wwwroot beside the executable. Empty: none. -->
    <OrielFrontendDist Condition="'$(OrielFrontendDist)' == ''"></OrielFrontendDist>
    <!-- The folder of the frontend's sources, where OrielFrontendBuildCommand runs. -->
    <OrielFrontendDirectory Condition="'$(OrielFrontendDirectory)' == ''">frontend</OrielFrontendDirectory>
    <!-- Builds the frontend before it is copied, in Release builds: for instance "npm run build". -->
    <OrielFrontendBuildCommand Condition="'$(OrielFrontendBuildCommand)' == ''"></OrielFrontendBuildCommand>

    <!-- Builds an installer after dotnet publish, with Inno Setup 6. docs/build.md#installers describes it. -->
    <OrielInstaller Condition="'$(OrielInstaller)' == ''">false</OrielInstaller>
    <!-- Desktop apps have no use for the XML documentation of their references: keep it out of what ships. -->
    <PublishReferencesDocumentationFiles Condition="'$(PublishReferencesDocumentationFiles)' == ''">false</PublishReferencesDocumentationFiles>
    <!-- The wizard's languages, by the names of Inno Setup's message files: english;french;german… -->
    <OrielInstallerLanguages Condition="'$(OrielInstallerLanguages)' == ''">english</OrielInstallerLanguages>
    <!-- The tasks Oriel's targets use, shipped in the package. -->
    <OrielBuildTasksAssembly Condition="'$(OrielBuildTasksAssembly)' == ''">$(MSBuildThisFileDirectory)../tasks/netstandard2.0/Oriel.Build.dll</OrielBuildTasksAssembly>
  </PropertyGroup>

  <ItemGroup>
    <!-- The npm package the TypeScript client imports its runtime from, such as oriel-runtime. Empty: the client carries it. -->
    <CompilerVisibleProperty Include="OrielTypeScriptRuntime" />
  </ItemGroup>
</Project>
