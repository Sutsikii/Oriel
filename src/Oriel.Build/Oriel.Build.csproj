<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The MSBuild tasks of apps using Oriel. MSBuild loads them, in Visual
    Studio too, so they target netstandard2.0. The Oriel package ships them
    under tasks/.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.14.28" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Oriel.Build.Tests" />
  </ItemGroup>

</Project>
