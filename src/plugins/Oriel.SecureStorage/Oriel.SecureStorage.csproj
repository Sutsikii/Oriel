<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Oriel.SecureStorage</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>An Oriel plugin: secrets of the app (tokens, passwords), encrypted for the user with DPAPI, for C# and for pages through a generated TypeScript client.</Description>
    <PackageTags>desktop;webview;oriel-plugin;secrets;dpapi</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <!-- As a plugin's package references Oriel's, all of whose assets flow to apps: the generator writes the services' dispatcher and client. -->
    <ProjectReference Include="../../Oriel/Oriel.csproj" PrivateAssets="none" />
    <ProjectReference Include="../../Oriel.Generators/Oriel.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <InternalsVisibleTo Include="Oriel.Plugins.Tests" />
  </ItemGroup>

</Project>
