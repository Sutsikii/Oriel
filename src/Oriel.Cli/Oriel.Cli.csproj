<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The oriel command: dotnet tool install -g Oriel.Cli, then oriel doctor
    and oriel dev. docs/getting-started.md shows them.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Oriel.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>oriel</ToolCommandName>
    <PackageId>Oriel.Cli</PackageId>
    <Description>The oriel command for Oriel apps: oriel doctor checks what building and shipping one needs, oriel dev runs one with its frontend's dev server.</Description>
    <PackageTags>desktop;webview;webview2;cli;dotnet-tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- For the WebView2 Runtime's lookup, the one apps make. -->
    <ProjectReference Include="../Oriel/Oriel.csproj" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="Oriel.Cli.Tests" />
  </ItemGroup>

</Project>
