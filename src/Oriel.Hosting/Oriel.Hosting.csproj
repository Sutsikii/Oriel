<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Oriel.Hosting</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Oriel apps on the .NET Generic Host: services from dependency injection, per call or per window, ILogger, configuration and hosted services.</Description>
    <PackageTags>desktop;webview;webview2;hosting;dependency-injection</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- OrielApp.CallFailed (ORIEL901) is logged here, and changes with it. -->
    <NoWarn>$(NoWarn);ORIEL901</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt;PublicAPI.Unshipped.txt" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <!-- All of Oriel's assets flow to apps: the generator and the build steps too. -->
    <ProjectReference Include="../Oriel/Oriel.csproj" PrivateAssets="none" />
    <InternalsVisibleTo Include="Oriel.Tests" />
  </ItemGroup>

</Project>
