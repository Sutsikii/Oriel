<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Benchmarks of calls: codecs, dispatchers, the protocol, and a round trip
    in a real window. See benchmarks/README.md; the Benchmarks workflow runs
    them and checks them against baseline.json.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- BenchmarkDotNet's types are not documented for this project's rules. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Oriel\Oriel.csproj" />
    <ProjectReference Include="..\..\src\Oriel.Generators\Oriel.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
